generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole { Patient Family_Caregiver Healthcare_Proxy }
enum DoseStatus { pending taken skipped }

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  dob          DateTime?
  role         UserRole @default(Patient)
  settings     Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  dependents   Dependent[]
}

model Dependent {
  id              String   @id @default(uuid())
  userId          String
  name            String
  relationship    String
  dob             DateTime?
  hipaaAuthorized Boolean  @default(false)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  medications     Medication[]
}

model Medication {
  id               String   @id @default(uuid())
  dependentId      String
  name             String
  genericName      String
  strength         String
  dosageInstructions String
  frequency        String
  pillsRemaining   Int
  totalPills       Int
  daysSupplyLeft   Int
  refillsRemaining Int
  isLowSupply      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  dependent        Dependent @relation(fields: [dependentId], references: [id], onDelete: Cascade)
  doses            Dose[]
}

model Dose {
  id            String     @id @default(uuid())
  medicationId  String
  scheduledDate DateTime
  timeSlot      String
  time          String
  status        DoseStatus @default(pending)
  takenAt       DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  medication    Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  @@index([scheduledDate])
}
